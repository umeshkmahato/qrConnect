{
  "name": "nathconnect",
  "version": "0.1.0",
  "private": true,
  "description": "NathConnect — QR-based vehicle verification and protected owner-contact platform",
  "workspaces": [
    "apps/api",
    "apps/admin-web",
    "packages/api-contracts"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/admin-web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
